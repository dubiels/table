DATABASE_PATH=./data/table.sqlite
ALLOWED_EMAILS=you@example.com
RESEND_API_KEY=
EMAIL_FROM="Table <table@yourdomain.com>"
PUBLIC_APP_URL=http://localhost:5173
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Cron expressions run in the container's local timezone (UTC on Fly by default unless TZ is set in fly.toml).
DIGEST_CRON=0 8 * * *
DUE_CHECK_CRON=0 * * * *
DUE_ALERT_LEAD_HOURS=24
DEV_LOG_TOKENS=false
# Canvas LMS assignment feed (the .ics URL from Canvas > Calendar > Calendar Feed)
LMS_ICAL_URL=
LMS_SYNC_CRON=0 */6 * * *
# Zone id (not name) that synced assignments land in; unset = place loose on the table
LMS_ZONE_ID=
# Long random string; the Pi wall display sends it as "Authorization: Bearer <token>".
# Unset = /api/dashboard is disabled (404), never open.
DASHBOARD_TOKEN=
